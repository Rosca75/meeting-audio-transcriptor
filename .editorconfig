# The editor rules the build enforces: a rule marked error fails the build.
root = true

[*]
charset = utf-8
# One line ending everywhere, because a diff of a converted file hides the real change.
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# One namespace per file, so no body is indented a level for nothing.
csharp_style_namespace_declarations = file_scoped:error
# var only where the type is apparent, because a reviewer reading a diff cannot hover.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
# Braces always, because a line added under an unbraced if changes its meaning silently.
csharp_prefer_braces = true:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
# Usings outside the namespace, so a file's dependencies are its first lines.
csharp_using_directive_placement = outside_namespace:error
dotnet_style_qualification_for_field = false:suggestion
# Accessibility is always written, so no member is public or private by accident.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
# A constructor body reads the same in every class.
csharp_style_prefer_primary_constructors = false:none
