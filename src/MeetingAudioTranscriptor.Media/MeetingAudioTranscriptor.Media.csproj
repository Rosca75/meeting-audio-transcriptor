<!-- Audio file decoding: a child ffmpeg process and, on Windows, Media Foundation interop. It is
     the only project that may allow unsafe code, because the interop needs it, and the engine
     receives only decoded samples. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MeetingAudioTranscriptor.Media</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeetingAudioTranscriptor.Engine\MeetingAudioTranscriptor.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Internal types (the converter, the parsers, the sources) are tested directly rather than
         made public for the test project. -->
    <InternalsVisibleTo Include="MeetingAudioTranscriptor.Media.Tests" />
  </ItemGroup>
</Project>
